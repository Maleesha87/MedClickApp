<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- State when the item is checked (selected) -->
    <item android:color="@color/nav_item_selected" android:state_checked="true"/>
    <!-- Default state when the item is unchecked (unselected) -->
    <item android:color="@color/nav_item_unselected" android:state_checked="false"/>
</selector>